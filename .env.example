# Telegram
TELEGRAM_BOT_TOKEN=COLE_AQUI_O_TOKEN
TELEGRAM_ALLOWED_USER_ID=COLE_AQUI_O_ID

# Segurança
# Na primeira instalação, execute preparar_seguranca_v40.py para gerar hashes.
# Defina seu PIN pessoal antes de iniciar. Em branco, o acesso fica bloqueado.
ASSESSOR_PIN=
ASSESSOR_PIN_HASH=
ASSESSOR_PIN_LENGTH=6
# Configure uma chave pessoal de recuperacao; a configuração protegida é obrigatória para iniciar o bot.
ASSESSOR_PIN_RESET_KEY=
ASSESSOR_PIN_RESET_KEY_HASH=
ASSESSOR_AUTOLOCK_MINUTES=15

# Alertas
ASSESSOR_ALERTAS_ATIVOS=true
ASSESSOR_LEMBRETE_PAGAMENTOS_ATIVO=true
ASSESSOR_LEMBRETE_PAGAMENTOS_HORA=10:00
ASSESSOR_ALERTA_DIARIO_HORA=22:00
ASSESSOR_RESUMO_DOMINGO_HORA=20:00
# Chat que recebe os alertas (em branco: o do titular).
ASSESSOR_ALERT_CHAT_ID=
# IGNORADA: o fuso é sempre UTC-3 fixo (relogio.py). Mantida só por compatibilidade.
# ASSESSOR_TIMEZONE=America/Sao_Paulo

# Backup
ASSESSOR_BACKUP_AUTOMATICO=true
ASSESSOR_BACKUP_HORA=03:00
# Cópia criptografada diária fora do PC (banco + código + .env). Ative com:
#   .\.venv\Scripts\python.exe backup_externo_cli.py configurar
# Em branco: %USERPROFILE%\OneDrive\Backups\Assessor
ASSESSOR_BACKUP_EXTERNO_DIR=
# Servidor Linux (sem o app do OneDrive): envia a cópia cifrada por rclone. Ex.: onedrive:Backups/Assessor
ASSESSOR_BACKUP_EXTERNO_RCLONE=

# Segurança de autenticação
ASSESSOR_PIN_MAX_ATTEMPTS=5
ASSESSOR_PIN_LOCK_MINUTES=15

# Por padrão o bot funciona apenas em conversa privada.
# Para permitir grupo, ambas as opções abaixo são obrigatórias.
ASSESSOR_ALLOW_GROUPS=false
ASSESSOR_ALLOWED_CHAT_ID=

# Recursos Telegram sem cobranças.
ASSESSOR_RICH_MESSAGES=1
# Impede encaminhamento e salvamento nativos de telas com dados financeiros.
# Capturas de tela continuam sendo uma limitação do cliente/dispositivo.
ASSESSOR_PROTECT_FINANCIAL_CONTENT=1
# Mostra progresso efêmero apenas para OCR, áudio e IA local.
ASSESSOR_STREAMING_PROGRESS=1
# Só publica o rascunho se a tarefa continuar após este intervalo.
ASSESSOR_STREAMING_DELAY=0.35
# Evita múltiplas atualizações de rascunho em sequência.
ASSESSOR_STREAMING_MIN_INTERVAL=0.75
# Mantém por até 10 minutos os fluxos e botões após reinício. O estado efêmero
# é protegido pelo DPAPI do Windows e nunca substitui o banco financeiro.
ASSESSOR_PERSIST_SESSIONS=true
# IA local: falha rápida e pausa temporária sem afetar as regras financeiras.
ASSESSOR_IA_CONNECT_TIMEOUT=0.5
ASSESSOR_IA_RESPONSE_TIMEOUT=6
ASSESSOR_IA_CIRCUIT_FAILURES=1
ASSESSOR_IA_CIRCUIT_SECONDS=30
ASSESSOR_IA_MODEL_CACHE_SECONDS=60
# Modelo do Ollama local (em branco: IA local desligada; só roteia intenção, nunca grava).
ASSESSOR_IA_LOCAL_MODELO=
# Limite do OCR local do Windows; após isso o formulário manual permanece disponível.
ASSESSOR_OCR_TIMEOUT=30
# Voz local robusta: whisper.cpp roda fora do Python e nunca grava sem confirmação.
ASSESSOR_AUDIO_PROVIDER=whisper_cpp
ASSESSOR_AUDIO_MODELO=base
ASSESSOR_AUDIO_IDIOMA=pt
ASSESSOR_AUDIO_THREADS=4
ASSESSOR_AUDIO_TIMEOUT=120
# Use apenas para caminhos personalizados; o padrão fica em .runtime/whispercpp.
ASSESSOR_AUDIO_CPP_EXE=
ASSESSOR_AUDIO_CPP_MODEL=
# Prompt inicial do whisper (em branco: prompt financeiro padrão).
ASSESSOR_AUDIO_PROMPT=

# Faturas e cartões (lidas a cada cálculo)
# Dia de corte padrão (inclusivo) e cortes por cartão em JSON, ex.: {"nubank": 3}.
ASSESSOR_FATURA_DIA_CORTE=25
ASSESSOR_FATURA_CORTES={}
# Contas fora da lista de bancos conhecidos viram cartão a partir desta data (AAAA-MM-DD).
ASSESSOR_CARTAO_NOVO_INICIO=2026-09-01
# Arquivo de regras pessoais de categoria (em branco: padrão do projeto).
ASSESSOR_CATEGORY_RULES_PATH=
